{
  "name": "safe-file-drag",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "description": "Firefox-only WebExtension: prevent accidental local-file drops from navigating the current tab, without breaking normal file uploads.",
  "license": "GPL-3.0-or-later",
  "author": "QZLin <qzlin01@163.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/QZLin/SafeFileDrag.git"
  },
  "homepage": "https://github.com/QZLin/SafeFileDrag#readme",
  "bugs": {
    "url": "https://github.com/QZLin/SafeFileDrag/issues"
  },
  "keywords": [
    "firefox",
    "webextension",
    "browser-extension",
    "drag-and-drop",
    "file-drop",
    "security"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "clean": "node scripts/clean.mjs",
    "typecheck": "tsc --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json",
    "test": "node scripts/test.mjs",
    "test:gecko": "pnpm run build && node scripts/test-gecko.mjs",
    "check": "pnpm run typecheck && pnpm run typecheck:test && pnpm run build && pnpm run test",
    "check:full": "pnpm run check && pnpm run test:gecko",
    "lint": "web-ext lint --source-dir dist",
    "sign": "pnpm run build && node scripts/sign.mjs",
    "start": "pnpm run build && node scripts/dev.mjs",
    "start:check": "pnpm run build && node scripts/dev.mjs --check"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.4",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.2",
    "typescript": "^7.0.2",
    "web-ext": "^10.7.0"
  }
}
