{
  "manifest_version": 3,
  "name": "Safe File Drag",
  "version": "1.0.1",
  "description": "Firefox-only guard: an accidental file drop no longer replaces the current tab with the dropped file, while real upload dropzones keep working.",
  "homepage_url": "https://github.com/QZLin/SafeFileDrag",
  "icons": {
    "16": "icon/logo_16.png",
    "32": "icon/logo_32.png",
    "48": "icon/logo_48.png",
    "96": "icon/logo_96.png",
    "128": "icon/logo_128.png",
    "256": "icon/logo_256.png"
  },
  "developer": {
    "name": "QZLin",
    "url": "https://github.com/QZLin"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "safe-file-drag@qzlin.github.io",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true,
      "match_about_blank": false
    }
  ]
}
