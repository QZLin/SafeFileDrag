{
  "manifest_version": 3,
  "name": "Safe File Drag",
  "version": "1.0.0",
  "description": "Firefox-only guard: an accidental file drop no longer replaces the current tab with the dropped file, while real upload dropzones keep working.",
  "browser_specific_settings": {
    "gecko": {
      "id": "safe-file-drag@local.invalid",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true,
      "match_about_blank": false
    }
  ]
}
